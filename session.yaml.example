# RelEasy session file — what to port.
# Default path: <config-dir>/<target_branch>.session.yaml
# Selection rules and every key: docs/configuration.md

# ── Static feature branches ─────────────────────────────────────────
features:
  - id: s3-disk                     # branch feature/<base>/<id>
    description: "Custom S3 disk improvements"
    source_branch: feature/antalya-s3-disk
    enabled: true

  - id: keeper-cfg
    description: "Keeper config extensions"
    source_branch: feature/antalya-keeper-cfg
    enabled: true
    # ai_context: |                 # hint for the AI resolver on conflict
    #   Prefer keeping our snake_case keys.

  - id: observability
    description: "Observability hooks"
    source_branch: feature/antalya-observability
    enabled: false

  # - id: disk-cache
  #   description: "Shared disk cache layer"
  #   source_branch: feature/antalya-disk-cache
  #   depends_on: [s3-disk]         # ported after these features
  #   enabled: true

# ── PR sources (needs RELEASY_GITHUB_TOKEN) ─────────────────────────
# pr_sources:
#   by_labels:                      # each entry: PR must carry ALL labels; entries are unioned
#     - labels: ["forward-port", "v26.1"]
#       description: "Forward-ported changes"   # PR title prefix
#       merged_only: true
#       # if_exists: recreate       # overrides pr_policy.if_exists
#       # ai_context: "..."         # resolver hint for every matched PR
#       # mode: auto                # auto | backport | forward_port
#
#   exclude_labels: ["do-not-port", "wontfix"]
#   include_authors: []             # restrict to these logins (when non-empty)
#   exclude_authors: ["dependabot[bot]"]
#
#   include_prs:                    # always included; any public repo
#     - https://github.com/Altinity/ClickHouse/pull/123
#     - https://github.com/ClickHouse/ClickHouse/pull/12345
#     - url: https://github.com/Altinity/ClickHouse/pull/456
#       ai_context: |
#         The base renamed `Foo::run` to `Foo::execute`. Adapt call sites.
#
#   exclude_prs:                    # never processed
#     - https://github.com/Altinity/ClickHouse/pull/789
#
#   on_hold:                        # parked, not vetoed; `run` skips the unit
#     - https://github.com/Altinity/ClickHouse/pull/2234
#     - url: https://github.com/Altinity/ClickHouse/pull/2249
#       reason: waiting for the upstream follow-up
#
#   groups:                         # several PRs → one branch, one combined PR
#     - id: iceberg-rest-catalog    # branch feature/<base>/<id>
#       description: "Iceberg REST catalog support"   # PR title
#       # ai_context: "..."         # hint for every step in the group
#       prs:
#         - https://github.com/Altinity/ClickHouse/pull/1500
#         - https://github.com/Altinity/ClickHouse/pull/1512
#         - url: https://github.com/Altinity/ClickHouse/pull/1530
#           ai_context: "Renames list_tables to list_namespaces."
#       # sort: listed              # listed | merged_at
#       # if_exists: skip
#       # mode: backport
#       # depends_on: [pr-123]      # unit ids (group id or pr-<N>) that must merge first
#
#   forward_port_labels: [port-antalya]   # PRs with these are forward-ports
#   # deps_file: deps/26.3.yaml     # default <session-stem>.deps.yaml

# ── Labels on every rebase PR of this session ───────────────────────
