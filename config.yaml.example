# RelEasy config.yaml — stable settings for one project.
# What to port lives in the session file (see session.yaml.example).
# Full reference: docs/configuration.md

# ── Identity (required) ─────────────────────────────────────────────
name: antalya-26.3                  # slug [A-Za-z0-9._-]{1,64}; keys the state file + lock
project: antalya                    # used in branch names and PR titles

origin:
  remote: https://github.com/Altinity/ClickHouse.git
  remote_name: origin

target_branch: antalya-26.3         # base branch (must exist on origin); unset = derive from --onto

# session_file: sessions/antalya-26.3.session.yaml   # default <config-dir>/<target_branch>.session.yaml
# work_dir: /path/to/ClickHouse     # default: cwd
# log_file: .releasy/releasy.log    # append transcript + INFO logs

# ── Behaviour ───────────────────────────────────────────────────────
# push: true                        # push branches and open PRs (default false)
# sequential: false                 # one PR per run, gated on the previous merging
# update_existing_prs: false        # overwrite title/body of an existing rebase PR
# merged_label: port-antalya        # add on merged rebase PR, strip from source PRs
# merged_label_color: "8B5CF6"

# upstream:                         # fetch-only; prerequisite detection
#   remote: https://github.com/ClickHouse/ClickHouse.git
#   remote_name: upstream
#   branch: master

# pr_policy:
#   if_exists: skip                 # skip | recreate | append (branch without a rebase PR)
#   auto_pr: true                   # open a PR for each pushed branch
#   retry_failed: true              # re-process `conflict` entries
#   recreate_closed_prs: false      # re-port closed PRs on a renumbered branch
#   recreate_reverted_prs: false    # same, for `reverted` entries
#   detect_superseded: true         # mark ports already cherry-picked elsewhere
#   honor_stall_reasons: true       # skip units stalled on something external
#   max_partial_continue_attempts: 2  # resumes of a partially applied group; 0 disables

# ── GitHub Project board (needs push: true) ─────────────────────────
notifications:
  github_project: https://github.com/orgs/Altinity/projects/1
  # assignee_dev_options: ["Octo Cat"]  # options when the field is first created
  # assignee_qa_options: ["Verified by Dev"]
  # assignee_dev_login_map:         # GitHub login → Assignee Dev option
  #   octocat: "Octo Cat"

# ── AI: shared ──────────────────────────────────────────────────────
# ai_backend: cli                   # cli | codex | api
# ai_model: opus                    # every AI call; ignored by codex
# ai_effort: high                   # low | medium | high | xhigh | max

# ai_api:                           # ai_backend: api
#   api_key_env: ANTHROPIC_API_KEY
#   # api_key: sk-ant-...           # used only if the env var is unset
#   # base_url: https://my-gateway
#   model: claude-opus-5            # overrides ai_model
#   max_tokens: 64000
#   max_turns: 300
#   thinking: true
#   max_retries: 5
#   request_timeout_seconds: 1800
#   bash_timeout_seconds: 3600
#   tool_output_max_chars: 30000
#   # system_prompt_extra: "Project-specific guidance."

# ai_codex:                         # ai_backend: codex
#   command: codex
#   model: gpt-5.5
#   reasoning_effort: high
#   extra_args: []

